{
  "name": "goat-online",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "data": "node scripts/build-data.mjs",
    "test:duel": "node test/headless-duel.ts",
    "typecheck": "tsc --noEmit",
    "server:dev": "wrangler dev --config server/wrangler.jsonc",
    "deploy:server": "wrangler deploy --config server/wrangler.jsonc",
    "deploy:app": "vite build && cd pages && wrangler pages deploy --branch main",
    "deploy": "npm run deploy:server && npm run deploy:app"
  },
  "dependencies": {
    "@fontsource/jersey-10": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "ocgcore-wasm": "0.1.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "@types/node": "^24.19.2",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "wrangler": "^4.166.0"
  }
}
